ndefined,\n      durationMs: boundary ? eventTimestampMs(boundary) - contextStart : undefined,\n    });\n  }\n```\n\nHelpers above deriveProgressMilestones:\n```ts\nconst ROUTE_MODE_LABELS: Record<string, string> = {\n  daily_chat: \"日常聊天\",\n  single_query: \"单次查询\",\n  analysis: \"数据分析\",\n  clarification: \"需要澄清\",\n};\n\n/** custom 事件在 harness 链路被归一化为 tool.progress + custom_type；旧 agent 链路保留原始 type，两种形态都要识别。 */\nexport function customEventOf(event: DebugEvent, name: string) {\n  return event.type === name\n    || (event.type === \"tool.progress\" && event.payload.custom_type === name);\n}\n\nfunction formatTokens(count: number) {\n  return count >= 1000 ? `${(count / 1000).toFixed(1)}k tokens` : `${count} tokens`;\n}\n```\n\nplan milestone matcher update:\n```ts\n  const planStart = firstMs((event) => event.type.startsWith(\"planner.\") || customEventOf(event, \"analysis_plan\"));\n  ...\n    const boundary = ordered.find((event) =>\n      event.type === \"planner.completed\"\n      || event.type === \"planner.failed\"\n      || (customEventOf(event, \"analysis_plan\") && (event.status === \"success\" || event.status === \"failed\")));\n```\n\nbuildTasks update:\n```ts\n    if (!customEventOf(event, \"analysis_plan\") || !Array.isArray(event.payload.tasks)) continue;\n```\n\nderiveRunStages (chat file): lines 57, 66, 67, 68, 70-73 — update:\n- `event.type.startsWith(\"context.\") || customEventOf(event, \"question_route\")`\n- plan: has(customEventOf(event, \"analysis_plan\")) etc.\n\nHmm wait — in harness mode, do tool.progress events carry `status` for analysis_plan? DebugEvent.status — how is it derived? From payload.status? The planner.failed paste shows top-level \"status\"? The pasted event had no status field... it had \"type\": \"planner.failed\" etc. For tool.progress events, DebugEvent.status — appendExecutionEvent probably sets status from payload.status. plan_analysis custom events include status field → payload.status → DebugEvent.status. I'll trust