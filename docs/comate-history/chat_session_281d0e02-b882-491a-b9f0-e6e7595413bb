s <= 0:\n    34→            raise ValueError(\"max_rows 必须大于 0\")\n    35→        self.context = context\n    36→        self.run_ref = run_ref\n    37→        self.asset_ids = asset_ids\n    38→        self.max_rows = max_rows\n    39→        self.event_writer = event_writer or NullHarnessEventWriter(run_ref=run_ref)\n    40→\n    41→    async def execute(self, value: QueryDataInput) -> QueryDataOutput:\n    42→        \"\"\"执行： 装配旧图 state，流式跑 query_graph，把最终状态收敛为受控查询结果。\"\"\"\n    43→        state: AgentState = {\n    44→            \"input_text\": value.query,\n    45→            \"original_question\": value.query,\n    46→            \"user_id\": self.run_ref.user_id,\n    47→            \"conversation_id\": self.run_ref.conversation_id,\n    48→            \"thread_id\": self.run_ref.thread_id,\n    49→            \"turn_id\": self.run_ref.turn_id,\n    50→            \"run_id\": self.run_ref.run_id,\n    51→            \"asset_ids\": list(self.asset_ids),\n    52→            \"query_max_rows\": self.max_rows,\n    53→        }\n    54→        latest_state: dict | None = None\n    55→        # bind：图内桥接事件统一挂 query_data 源（tool.progress 的 source 形如 query_data:节点名）\n    56→        with self.event_writer.bind(\n    57→            source=self.name,\n    58→            phase=\"execute_tool\",\n    59→            action_id=None,\n    60→        ):\n    61→            async for event in query_graph.astream(\n    62→                state,\n    63→                context=self.context,\n    64→                stream_mode=[\"custom\", \"values\"],\n    65→            ):\n    66→                if not isinstance(event, tuple) or len(event) != 2:\n    67→                    continue\n    68→                mode, payload = event\n    69→                if mode == \"custom\":\n    70→                    # custom = 节点内部进度事件，归一化为 tool.progress 推给前端\n</file>\n<metadata>The file has 110 lines in total.</metadata>","metadata":{"relativePath":"app/agent/business_tools/query_data/too