NLY_PATTERN = re.compile(\n    18→    r\"^(?:这个|该|当前|刚才(?:的)?|上面(?:的)?|我上传(?:的)?)?\"\n    19→    r\"(?:附件|文件|图片|截图|音频|视频)\"\n    20→    r\"(?:(?:中|里|中的|里的)(?:内容|信息|数据)?|(?:内容|信息|数据))?$\"\n    21→)\n    22→_ATTACHMENT_REFERENCE_PATTERN = re.compile(\n    23→    r\"(?:这个|这些|该|当前|刚才(?:的)?|上面(?:的)?|我上传(?:的)?)?\"\n    24→    r\"(?:附件|文件|图片|截图|音频|视频)\"\n    25→)\n    26→\n    27→\n    28→class ExplicitMemoryExtractor:\n    29→    \"\"\"把无法结构化的显式记忆请求保真保存为 Semantic 候选。\"\"\"\n    30→\n    31→    def __init__(self, *, memory_request_pattern: re.Pattern[str] | None = None) -> None:\n    32→        # 与 Eligibility 共享产品级显式记忆意图，避免“已判定显式”却无法兜底提取。\n    33→        self.memory_request_pattern = memory_request_pattern or _MEMORY_REQUEST_PATTERN\n    34→\n    35→    def extract(self, turn: TurnMemoryInput) -> list[MemoryCandidate]:\n    36→        \"\"\"从本轮用户输入提取零到多条显式候选。\"\"\"\n    37→        text = turn.input_text.strip()\n    38→        if not text:\n    39→            return []\n    40→        if not self._contains_memory_request(text):\n    41→            return []\n    42→        content = self._generic_content(text)\n    43→        if not content or _ATTACHMENT_ONLY_PATTERN.fullmatch(content):\n    44→            return []\n    45→        return [\n    46→            MemoryCandidate(\n    47→                memory_type=MemoryType.SEMANTIC,\n    48→                content=content,\n    49→                # 兜底不猜字段含义；后续同文可去重，人工或 LLM 可再结构化。\n    50→                fact_key=\"\",\n    51→                value=content,\n    52→                importance=0.7,\n    53→                confidence=1.0,\n    54→                reason=\"用户明确要求保存该信息，LLM 结构化不可用。\",\n    55→            )\n    56→        ]\n    57→\n    58→    def _contains_memory_request(self, text: str) -> bool:\n    59→        return bool(self.memory_request_pattern.search(text))\n    60→\n</file>\n<metadata>The file has 74 lines in total.</metadata>","metadata":{"relativePath":"app/agent/memory/explicit_extractor.py","absol